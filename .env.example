# .env.example — environment configuration template for @telefraudbot.
#
# Copy to `.env` and fill in your values:   cp .env.example .env
# `.env` is git-ignored and docker-ignored — never commit real secrets.

# --- Required ---
# Telegram Bot API token from @BotFather.
BOT_TOKEN=your_bot_token_here

# --- PostgreSQL ---
# Used by docker compose's `db` service (and by host `go run` if you point
# DATABASE_URL at a local Postgres).
POSTGRES_USER=telefraud
POSTGRES_PASSWORD=secret
POSTGRES_DB=telefraud_db

# Connection URL for running the bot directly on the host (not via compose).
# docker compose overrides this to reach the `db` service container instead.
DATABASE_URL=postgres://telefraud:secret@localhost:5432/telefraud_db?sslmode=disable

# --- Admins ---
# Comma-separated Telegram user IDs with admin privileges.
ADMIN_IDS=12345678,87654321
# Channel/supergroup ID for admin logs & report reviews.
ADMIN_LOG_CHAT_ID=-1001234567890

# --- Backup ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# --- Required Channel Subscription (Force Join) ---
REQUIRED_CHANNEL_ID=-1004458146162
REQUIRED_CHANNEL_LINK=https://t.me/telefraud_info

# --- Branding ---
DEVELOPER_NAME=xspoilt
DEVELOPER_USERNAME=@x_spoilt
